    given-names: Yikuan
    orcid: "https://orcid.org/0000-0001-7546-9979"
version: 0.1.0
date-released: "2026-06-20"
license: MIT
url: "https://github.com/yikuan8/MetaMaPy"
repository-code: "https://github.com/yikuan8/MetaMaPy"
keywords:
  - UMLS
  - MetaMap
  - MetaMapLite
  - clinical NLP
  - named entity recognition
  - concept extraction
